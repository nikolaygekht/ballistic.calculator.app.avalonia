<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="240"
             FontSize="{DynamicResource AppFontSize}"
             x:Class="BallisticCalculator.Panels.Panels.SummaryPanel">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <!-- Left-aligned compact block: the value column stays next to the labels no matter how wide
         the tab is, instead of stretching the value to the far edge of the window. -->
    <Grid Margin="10" HorizontalAlignment="Left"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto" MinWidth="90"/>
      </Grid.ColumnDefinitions>

      <SelectableTextBlock Grid.Row="0" Grid.Column="0" Text="Zero adjustment (vertical):" Margin="0,2,20,2"/>
      <SelectableTextBlock Grid.Row="0" Grid.Column="1" x:Name="ZeroVValue" x:FieldModifier="internal"
                           HorizontalAlignment="Right" Margin="0,2" Text="n/a"/>

      <SelectableTextBlock Grid.Row="1" Grid.Column="0" Text="Zero adjustment (horizontal):" Margin="0,2,20,2"/>
      <SelectableTextBlock Grid.Row="1" Grid.Column="1" x:Name="ZeroHValue" x:FieldModifier="internal"
                           HorizontalAlignment="Right" Margin="0,2" Text="n/a"/>

      <SelectableTextBlock Grid.Row="2" Grid.Column="0" Text="Target size:" Margin="0,2,20,2"/>
      <SelectableTextBlock Grid.Row="2" Grid.Column="1" x:Name="TargetSizeValue" x:FieldModifier="internal"
                           HorizontalAlignment="Right" Margin="0,2" Text="n/a"/>

      <SelectableTextBlock Grid.Row="3" Grid.Column="0" Text="Dead zone (bottom-aimed):" Margin="0,2,20,2"/>
      <SelectableTextBlock Grid.Row="3" Grid.Column="1" x:Name="DeadZoneValue" x:FieldModifier="internal"
                           HorizontalAlignment="Right" Margin="0,2" Text="n/a"/>

      <SelectableTextBlock Grid.Row="4" Grid.Column="0" Text="Dead zone (center-aimed):" Margin="0,2,20,2"/>
      <SelectableTextBlock Grid.Row="4" Grid.Column="1" x:Name="DeadZoneCenterValue" x:FieldModifier="internal"
                           HorizontalAlignment="Right" Margin="0,2" Text="n/a"/>

      <SelectableTextBlock Grid.Row="5" Grid.Column="0" Text="Near zero:" Margin="0,2,20,2"/>
      <SelectableTextBlock Grid.Row="5" Grid.Column="1" x:Name="NearZeroValue" x:FieldModifier="internal"
                           HorizontalAlignment="Right" Margin="0,2" Text="n/a"/>

      <SelectableTextBlock Grid.Row="6" Grid.Column="0" Text="Far zero:" Margin="0,2,20,2"/>
      <SelectableTextBlock Grid.Row="6" Grid.Column="1" x:Name="FarZeroValue" x:FieldModifier="internal"
                           HorizontalAlignment="Right" Margin="0,2" Text="n/a"/>

      <SelectableTextBlock Grid.Row="7" Grid.Column="0" Text="Subsonic distance:" Margin="0,2,20,2"/>
      <SelectableTextBlock Grid.Row="7" Grid.Column="1" x:Name="SubsonicValue" x:FieldModifier="internal"
                           HorizontalAlignment="Right" Margin="0,2" Text="n/a"/>

    </Grid>
  </ScrollViewer>
</UserControl>
