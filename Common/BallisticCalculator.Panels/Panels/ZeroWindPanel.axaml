<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:panels="using:BallisticCalculator.Panels.Panels"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="200"
             x:Class="BallisticCalculator.Panels.Panels.ZeroWindPanel">

  <StackPanel Spacing="4">
    <CheckBox x:Name="EnableCheckBox" x:FieldModifier="internal"
              Content="Wind at zero"
              FontSize="{DynamicResource AppFontSize}"/>

    <panels:WindPanel x:Name="WindSubPanel" x:FieldModifier="internal"
                      IsEnabled="False"
                      FontSize="{DynamicResource AppFontSize}"/>
  </StackPanel>
</UserControl>
