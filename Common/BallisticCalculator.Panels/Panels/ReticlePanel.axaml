<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:BallisticCalculator.Controls.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="BallisticCalculator.Panels.Panels.ReticlePanel">

  <Grid ColumnDefinitions="*,Auto">

    <!-- Left: Reticle canvas -->
    <controls:ReticleCanvasControl Grid.Column="0"
               x:Name="ReticleCanvas" x:FieldModifier="internal"
               Margin="0,0,4,0"/>

    <!-- Right: Controls -->
    <Border Grid.Column="1" Width="325" Padding="5">
      <StackPanel Spacing="4">

        <!-- Reticle loading -->
        <TextBlock Text="Reticle:"
                   FontWeight="Bold"
                   FontSize="{DynamicResource AppFontSize}"/>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button x:Name="LoadReticleButton" x:FieldModifier="internal"
                  Content="Load..."
                  Click="OnLoadReticle"
                  FontSize="{DynamicResource AppFontSize}"/>
          <Button x:Name="MilDotButton" x:FieldModifier="internal"
                  Content="Mil-Dot"
                  Click="OnMilDot"
                  FontSize="{DynamicResource AppFontSize}"/>
        </StackPanel>

        <TextBlock x:Name="ReticleNameText" x:FieldModifier="internal"
                   Text="(none)"
                   FontSize="{DynamicResource AppFontSize}"
                   Foreground="Gray"/>

        <Separator Margin="0,4"/>

        <!-- Display mode -->
        <TextBlock Text="Display:"
                   FontWeight="Bold"
                   FontSize="{DynamicResource AppFontSize}"/>
        <RadioButton x:Name="RadioNone" x:FieldModifier="internal"
                     Content="None"
                     GroupName="DisplayMode"
                     IsChecked="True"
                     IsCheckedChanged="OnDisplayModeChanged"
                     FontSize="{DynamicResource AppFontSize}"/>
        <RadioButton x:Name="RadioFarBdc" x:FieldModifier="internal"
                     Content="Far BDC"
                     GroupName="DisplayMode"
                     IsCheckedChanged="OnDisplayModeChanged"
                     FontSize="{DynamicResource AppFontSize}"/>
        <RadioButton x:Name="RadioNearBdc" x:FieldModifier="internal"
                     Content="Near BDC"
                     GroupName="DisplayMode"
                     IsCheckedChanged="OnDisplayModeChanged"
                     FontSize="{DynamicResource AppFontSize}"/>
        <RadioButton x:Name="RadioTarget" x:FieldModifier="internal"
                     Content="Target"
                     GroupName="DisplayMode"
                     IsCheckedChanged="OnDisplayModeChanged"
                     FontSize="{DynamicResource AppFontSize}"/>

        <!-- Where Near stops and Far starts. It follows the shot's zero until you change it, which is
             right for a centrefire zeroed at 100 and wrong for a .22 LR or a subsonic load, where most
             of the interesting trajectory is on one side of that. -->
        <StackPanel x:Name="BdcSplitPanel" x:FieldModifier="internal"
                    Spacing="4" IsEnabled="False" Margin="0,4,0,0">
          <Grid ColumnDefinitions="70,*">
            <TextBlock Grid.Column="0" Text="Split at:"
                       VerticalAlignment="Center"
                       ToolTip.Tip="Marks nearer than this are Near BDC, the rest are Far BDC"
                       FontSize="{DynamicResource AppFontSize}"/>
            <controls:MeasurementControl Grid.Column="1"
                       x:Name="BdcSplitControl" x:FieldModifier="internal"
                       FontSize="{DynamicResource AppFontSize}"/>
          </Grid>
        </StackPanel>

        <Separator Margin="0,4"/>

        <!-- Target controls -->
        <StackPanel x:Name="TargetControlsPanel" x:FieldModifier="internal"
                    Spacing="4" IsEnabled="False">

          <TextBlock Text="Target:"
                     FontWeight="Bold"
                     FontSize="{DynamicResource AppFontSize}"/>

          <!-- Size -->
          <Grid ColumnDefinitions="70,*,Auto,*">
            <TextBlock Grid.Column="0" Text="Size:"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource AppFontSize}"/>
            <NumericUpDown Grid.Column="1"
                           x:Name="TargetWidthControl" x:FieldModifier="internal"
                           Value="6" Minimum="0.1" Maximum="10000" Increment="1"
                           FormatString="F1"
                           FontSize="{DynamicResource AppFontSize}"/>
            <TextBlock Grid.Column="2" Text=" x "
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource AppFontSize}"/>
            <NumericUpDown Grid.Column="3"
                           x:Name="TargetHeightControl" x:FieldModifier="internal"
                           Value="6" Minimum="0.1" Maximum="10000" Increment="1"
                           FormatString="F1"
                           FontSize="{DynamicResource AppFontSize}"/>
          </Grid>

          <!-- Size units -->
          <Grid ColumnDefinitions="70,*">
            <TextBlock Grid.Column="0" Text="Units:"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource AppFontSize}"/>
            <ComboBox Grid.Column="1"
                      x:Name="TargetSizeUnitsCombo" x:FieldModifier="internal"
                      SelectedIndex="0"
                      FontSize="{DynamicResource AppFontSize}"
                      HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Inch"/>
              <ComboBoxItem Content="Centimeter"/>
            </ComboBox>
          </Grid>

          <!-- Distance -->
          <Grid ColumnDefinitions="70,*">
            <TextBlock Grid.Column="0" Text="Distance:"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource AppFontSize}"/>
            <controls:MeasurementControl Grid.Column="1"
                       x:Name="TargetDistanceControl" x:FieldModifier="internal"
                       FontSize="{DynamicResource AppFontSize}"/>
          </Grid>

          <!-- Optional offset, so the box can be parked somewhere other than the hold — on a
               reticle's ranging stadia, for instance, to try the scale against a known target size.
               Reticle convention: X positive right, Y positive up. -->
          <Grid ColumnDefinitions="70,*">
            <TextBlock Grid.Column="0" Text="Offset H:"
                       VerticalAlignment="Center"
                       ToolTip.Tip="Moves the target box sideways from the hold. Positive is right; leave empty for none"
                       FontSize="{DynamicResource AppFontSize}"/>
            <controls:MeasurementControl Grid.Column="1"
                       x:Name="TargetOffsetHControl" x:FieldModifier="internal"
                       FontSize="{DynamicResource AppFontSize}"/>
          </Grid>

          <Grid ColumnDefinitions="70,*">
            <TextBlock Grid.Column="0" Text="Offset V:"
                       VerticalAlignment="Center"
                       ToolTip.Tip="Moves the target box up or down from the hold. Positive is up; leave empty for none"
                       FontSize="{DynamicResource AppFontSize}"/>
            <controls:MeasurementControl Grid.Column="1"
                       x:Name="TargetOffsetVControl" x:FieldModifier="internal"
                       FontSize="{DynamicResource AppFontSize}"/>
          </Grid>

          <TextBlock x:Name="TargetAngularSizeText" x:FieldModifier="internal"
                     Text=""
                     Foreground="Gray"
                     FontSize="{DynamicResource AppFontSize}"/>

          <Separator Margin="0,4"/>

          <!-- Moving target -->
          <CheckBox x:Name="MovingTargetCheck" x:FieldModifier="internal"
                    Content="Moving target"
                    FontWeight="Bold"
                    FontSize="{DynamicResource AppFontSize}"/>

          <StackPanel x:Name="MovingTargetControlsPanel" x:FieldModifier="internal"
                      Spacing="4" IsEnabled="False">

            <!-- Direction (numeric, synced with dial) + speed, with the dial on the right -->
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="4">

                <Grid ColumnDefinitions="60,*">
                  <TextBlock Grid.Column="0" Text="Direction:"
                             VerticalAlignment="Center"
                             FontSize="{DynamicResource AppFontSize}"/>
                  <controls:MeasurementControl Grid.Column="1"
                             x:Name="MovingDirectionInput" x:FieldModifier="internal"
                             FontSize="{DynamicResource AppFontSize}"/>
                </Grid>

                <Grid ColumnDefinitions="60,*">
                  <TextBlock Grid.Column="0" Text="Speed:"
                             VerticalAlignment="Center"
                             FontSize="{DynamicResource AppFontSize}"/>
                  <controls:MeasurementControl Grid.Column="1"
                             x:Name="MovingSpeedControl" x:FieldModifier="internal"
                             FontSize="{DynamicResource AppFontSize}"/>
                </Grid>

              </StackPanel>

              <controls:AzimuthDirectionControl Grid.Column="1"
                         x:Name="MovingDirectionControl" x:FieldModifier="internal"
                         Width="64" Margin="8,0,0,0"
                         VerticalAlignment="Stretch"/>
            </Grid>

            <TextBlock x:Name="LeadCorrectionText" x:FieldModifier="internal"
                       Text=""
                       Foreground="Gray"
                       FontSize="{DynamicResource AppFontSize}"/>

          </StackPanel>

        </StackPanel>

      </StackPanel>
    </Border>

  </Grid>
</UserControl>
