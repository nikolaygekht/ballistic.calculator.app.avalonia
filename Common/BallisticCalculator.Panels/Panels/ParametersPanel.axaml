<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:BallisticCalculator.Controls.Controls"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="200"
             x:Class="BallisticCalculator.Panels.Panels.ParametersPanel">

  <StackPanel Spacing="4">

    <!-- Maximum Range -->
    <Grid ColumnDefinitions="100,*">
      <TextBlock Grid.Column="0" Text="Max Range:"
                 VerticalAlignment="Center"
                 FontWeight="Bold"
                 FontSize="{DynamicResource AppFontSize}"/>
      <controls:MeasurementControl Grid.Column="1"
                 x:Name="MaxRangeControl" x:FieldModifier="internal"
                 FontSize="{DynamicResource AppFontSize}"/>
    </Grid>

    <!-- Step -->
    <Grid ColumnDefinitions="100,*">
      <TextBlock Grid.Column="0" Text="Step:"
                 VerticalAlignment="Center"
                 FontWeight="Bold"
                 FontSize="{DynamicResource AppFontSize}"/>
      <controls:MeasurementControl Grid.Column="1"
                 x:Name="StepControl" x:FieldModifier="internal"
                 FontSize="{DynamicResource AppFontSize}"/>
    </Grid>

    <Separator/>

    <!-- Shot Angle (line-of-sight incline) -->
    <Grid ColumnDefinitions="100,*">
      <TextBlock Grid.Column="0" Text="Shot Angle:"
                 VerticalAlignment="Center"
                 FontSize="{DynamicResource AppFontSize}"/>
      <controls:MeasurementControl Grid.Column="1"
                 x:Name="AngleControl" x:FieldModifier="internal"
                 FontSize="{DynamicResource AppFontSize}"/>
    </Grid>

    <!-- Vertical clicks dialed for the shot -->
    <Grid ColumnDefinitions="100,*">
      <TextBlock Grid.Column="0" Text="V-Clicks:"
                 VerticalAlignment="Center"
                 FontSize="{DynamicResource AppFontSize}"/>
      <NumericUpDown Grid.Column="1"
                 x:Name="VClicksControl" x:FieldModifier="internal"
                 HorizontalAlignment="Left" Width="120"
                 Minimum="-200" Maximum="200" Increment="1" FormatString="0" Value="0"
                 FontSize="{DynamicResource AppFontSize}"/>
    </Grid>

    <!-- Horizontal clicks dialed for the shot -->
    <Grid ColumnDefinitions="100,*">
      <TextBlock Grid.Column="0" Text="H-Clicks:"
                 VerticalAlignment="Center"
                 FontSize="{DynamicResource AppFontSize}"/>
      <NumericUpDown Grid.Column="1"
                 x:Name="HClicksControl" x:FieldModifier="internal"
                 HorizontalAlignment="Left" Width="120"
                 Minimum="-200" Maximum="200" Increment="1" FormatString="0" Value="0"
                 FontSize="{DynamicResource AppFontSize}"/>
    </Grid>

    <Separator/>

    <!-- Coriolis / Eötvös -->
    <CheckBox x:Name="CoriolisCheckBox" x:FieldModifier="internal"
              Content="Calculate Coriolis Effect"
              FontSize="{DynamicResource AppFontSize}"/>

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="4">

        <!-- Azimuth (compass bearing of the line of fire, 0 = North) -->
        <Grid ColumnDefinitions="100,*">
          <TextBlock Grid.Column="0" Text="Azimuth:"
                     VerticalAlignment="Center"
                     FontSize="{DynamicResource AppFontSize}"/>
          <controls:MeasurementControl Grid.Column="1"
                     x:Name="AzimuthControl" x:FieldModifier="internal"
                     IsEnabled="False"
                     FontSize="{DynamicResource AppFontSize}"/>
        </Grid>

        <!-- Latitude (magnitude) with N/S hemisphere selector -->
        <Grid ColumnDefinitions="100,*">
          <TextBlock Grid.Column="0" Text="Latitude:"
                     VerticalAlignment="Center"
                     FontSize="{DynamicResource AppFontSize}"/>
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
            <controls:MeasurementControl Grid.Column="0"
                       x:Name="LatitudeControl" x:FieldModifier="internal"
                       IsEnabled="False"
                       FontSize="{DynamicResource AppFontSize}"/>
            <ComboBox Grid.Column="1"
                      x:Name="LatitudeHemisphere" x:FieldModifier="internal"
                      Width="60" SelectedIndex="0" IsEnabled="False" Margin="4,0,0,0"
                      FontSize="{DynamicResource AppFontSize}">
              <ComboBoxItem>N</ComboBoxItem>
              <ComboBoxItem>S</ComboBoxItem>
            </ComboBox>
          </Grid>
        </Grid>

      </StackPanel>

      <!-- Azimuth dial: arrow points shooter -> target, 0 = North (up) -->
      <controls:AzimuthDirectionControl Grid.Column="1"
                 x:Name="AzimuthIndicator" x:FieldModifier="internal"
                 Width="80" Height="80" Margin="8,0,0,0"
                 IsEnabled="False"/>
    </Grid>

  </StackPanel>
</UserControl>
