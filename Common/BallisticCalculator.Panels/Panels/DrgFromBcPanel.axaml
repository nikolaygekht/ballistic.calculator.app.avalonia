<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:BallisticCalculator.Controls.Controls"
             xmlns:models="using:BallisticCalculator.Panels.Models"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="520"
             x:Class="BallisticCalculator.Panels.Panels.DrgFromBcPanel">

  <StackPanel Spacing="4">

    <!-- Header: one field per row, all the same width -->
    <Grid ColumnDefinitions="90,*">
      <TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center"
                 FontSize="{DynamicResource AppFontSize}"/>
      <TextBox Grid.Column="1" x:Name="NameBox" x:FieldModifier="internal"
               FontSize="{DynamicResource AppFontSize}"/>
    </Grid>

    <Grid ColumnDefinitions="90,*">
      <TextBlock Grid.Column="0" Text="Source" VerticalAlignment="Center"
                 FontSize="{DynamicResource AppFontSize}"/>
      <TextBox Grid.Column="1" x:Name="SourceBox" x:FieldModifier="internal"
               FontSize="{DynamicResource AppFontSize}"/>
    </Grid>

    <Grid ColumnDefinitions="90,*">
      <TextBlock Grid.Column="0" Text="Weight" VerticalAlignment="Center"
                 FontSize="{DynamicResource AppFontSize}"/>
      <controls:MeasurementControl Grid.Column="1" x:Name="WeightControl" x:FieldModifier="internal"
                                   FontSize="{DynamicResource AppFontSize}"/>
    </Grid>

    <Grid ColumnDefinitions="90,*">
      <TextBlock Grid.Column="0" Text="Diameter" VerticalAlignment="Center"
                 FontSize="{DynamicResource AppFontSize}"/>
      <controls:MeasurementControl Grid.Column="1" x:Name="DiameterControl" x:FieldModifier="internal"
                                   FontSize="{DynamicResource AppFontSize}"/>
    </Grid>

    <Grid ColumnDefinitions="90,*">
      <TextBlock Grid.Column="0" Text="Length" VerticalAlignment="Center"
                 FontSize="{DynamicResource AppFontSize}"/>
      <controls:MeasurementControl Grid.Column="1" x:Name="LengthControl" x:FieldModifier="internal"
                                   FontSize="{DynamicResource AppFontSize}"/>
    </Grid>

    <TextBlock Text="Weight and diameter are required — the curve is scaled by the bullet's sectional density."
               Foreground="Gray" TextWrapping="Wrap"
               FontSize="{DynamicResource AppFontSize}"/>

    <Grid ColumnDefinitions="90,Auto,*">
      <TextBlock Grid.Column="0" Text="Base table" VerticalAlignment="Center"
                 FontSize="{DynamicResource AppFontSize}"/>
      <ComboBox Grid.Column="1" x:Name="BaseTableCombo" x:FieldModifier="internal" Width="90"
                FontSize="{DynamicResource AppFontSize}"/>
      <TextBlock Grid.Column="2" Text="the standard curve the knots scale"
                 VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"
                 FontSize="{DynamicResource AppFontSize}"/>
    </Grid>

    <Separator/>

    <!-- Knots -->
    <DataGrid x:Name="KnotsGrid" x:FieldModifier="internal"
              x:DataType="models:BcKnotEditModel"
              AutoGenerateColumns="False"
              Height="170"
              IsReadOnly="True"
              CanUserSortColumns="False"
              GridLinesVisibility="All"
              HeadersVisibility="Column"
              SelectionMode="Single"
              FontSize="{DynamicResource AppFontSize}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Mach" Binding="{Binding MachText}" Width="*"/>
        <DataGridTextColumn Header="BC" Binding="{Binding BcText}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Entry row for the selected/new knot -->
    <Grid ColumnDefinitions="90,110,60,*">
      <TextBlock Grid.Column="0" Text="Mach" VerticalAlignment="Center"
                 FontSize="{DynamicResource AppFontSize}"/>
      <TextBox Grid.Column="1" x:Name="MachBox" x:FieldModifier="internal"
               FontSize="{DynamicResource AppFontSize}"/>
      <TextBlock Grid.Column="2" Text="BC" VerticalAlignment="Center" Margin="8,0,0,0"
                 FontSize="{DynamicResource AppFontSize}"/>
      <controls:BallisticCoefficientControl Grid.Column="3" x:Name="BcControl" x:FieldModifier="internal"
                                            FontSize="{DynamicResource AppFontSize}"/>
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="6">
      <Button x:Name="AddButton" x:FieldModifier="internal" Content="Add" Click="OnAdd" Width="70"
              FontSize="{DynamicResource AppFontSize}"/>
      <Button x:Name="ChangeButton" x:FieldModifier="internal" Content="Change" Click="OnChange" Width="70"
              FontSize="{DynamicResource AppFontSize}"/>
      <Button x:Name="DeleteButton" x:FieldModifier="internal" Content="Delete" Click="OnDelete" Width="70"
              FontSize="{DynamicResource AppFontSize}"/>
      <Button x:Name="SortButton" x:FieldModifier="internal" Content="Sort" Click="OnSort" Width="70"
              FontSize="{DynamicResource AppFontSize}"/>
      <Button x:Name="ImportButton" x:FieldModifier="internal" Content="Load Csv" Click="OnImport" Width="90"
              FontSize="{DynamicResource AppFontSize}"/>
    </StackPanel>

    <TextBlock x:Name="StatusText" x:FieldModifier="internal"
               TextWrapping="Wrap" MinHeight="32"
               FontSize="{DynamicResource AppFontSize}"/>

    <!-- Actions -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="SaveButton" x:FieldModifier="internal" Content="Save Drg" Click="OnSave" Width="90"
              FontSize="{DynamicResource AppFontSize}"/>
      <Button x:Name="CloseButton" x:FieldModifier="internal" Content="Close" Click="OnClose" Width="90"
              FontSize="{DynamicResource AppFontSize}"/>
    </StackPanel>

  </StackPanel>
</UserControl>
