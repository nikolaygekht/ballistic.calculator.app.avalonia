<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="BallisticCalculator.Views.Dialogs.MessageDialog"
        Title="Message"
        Width="460"
        MinHeight="150" MaxHeight="600"
        SizeToContent="Height"
        FontSize="{DynamicResource AppFontSize}"
        WindowStartupLocation="CenterOwner"
        CanResize="true">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal" HorizontalAlignment="Center"
                Margin="0,20,0,0">
      <Button x:Name="OkButton" x:FieldModifier="internal"
              Content="OK" MinWidth="90" Padding="12,4"
              Click="OnOk" IsDefault="True" IsCancel="True"
              FontSize="{DynamicResource AppFontSize}"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <TextBlock x:Name="MessageText" x:FieldModifier="internal"
                 TextWrapping="Wrap"
                 FontSize="{DynamicResource AppFontSize}"/>
    </ScrollViewer>

  </DockPanel>
</Window>
