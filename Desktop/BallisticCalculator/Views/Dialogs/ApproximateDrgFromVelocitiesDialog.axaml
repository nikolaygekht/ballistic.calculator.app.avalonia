<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="using:BallisticCalculator.Panels.Panels"
        x:Class="BallisticCalculator.Views.Dialogs.ApproximateDrgFromVelocitiesDialog"
        Title="Approximate Drag Table — From Measured Velocities"
        Width="700" Height="620"
        MinWidth="620" MinHeight="520"
        FontSize="{DynamicResource AppFontSize}"
        WindowStartupLocation="CenterOwner"
        CanResize="true">

  <DockPanel Margin="12">
    <Button DockPanel.Dock="Bottom" Content="Close" Click="OnClose" Width="80"
            HorizontalAlignment="Right" Margin="0,12,0,0"
            FontSize="{DynamicResource AppFontSize}"/>

    <panels:DrgFromVelocitiesPanel x:Name="EditorPanel" x:FieldModifier="internal"
                                   FontSize="{DynamicResource AppFontSize}"/>
  </DockPanel>
</Window>
