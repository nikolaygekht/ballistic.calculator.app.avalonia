<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="using:BallisticCalculator.Panels.Panels"
        x:Class="BallisticCalculator.Views.Dialogs.ApproximateDrgFromVelocitiesDialog"
        Title="Approximate Drag Table — From Measured Velocities"
        Width="600" Height="640"
        MinWidth="480" MinHeight="300"
        FontSize="{DynamicResource AppFontSize}"
        WindowStartupLocation="CenterOwner"
        CanResize="true">

  <!-- The panel does its own scrolling, because it owns the action row it has to keep pinned below
       the scrolled area. A ScrollViewer here would nest inside that one and re-hide the buttons. -->
  <panels:DrgFromVelocitiesPanel x:Name="EditorPanel" x:FieldModifier="internal" Margin="12"
                                 FontSize="{DynamicResource AppFontSize}"/>
</Window>
