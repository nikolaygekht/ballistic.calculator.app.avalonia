<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="using:BallisticCalculator.Panels.Panels"
        x:Class="BallisticCalculator.Views.Dialogs.ApproximateDrgFromVelocitiesDialog"
        Title="Approximate Drag Table — From Measured Velocities"
        Width="600" Height="640"
        MinWidth="480" MinHeight="300"
        FontSize="{DynamicResource AppFontSize}"
        WindowStartupLocation="CenterOwner"
        CanResize="true">

  <!-- Scrolls so the dialog stays usable on a short screen; the grid inside keeps its own height. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
    <panels:DrgFromVelocitiesPanel x:Name="EditorPanel" x:FieldModifier="internal"
                                   FontSize="{DynamicResource AppFontSize}"/>
  </ScrollViewer>
</Window>
