<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="using:BallisticCalculator.Panels.Panels"
        x:Class="BallisticCalculator.Views.Dialogs.BcConverterDialog"
        Title="Convert Ballistic Coefficient"
        Width="500" Height="340"
        MinWidth="420" MinHeight="240"
        FontSize="{DynamicResource AppFontSize}"
        WindowStartupLocation="CenterOwner"
        CanResize="true">

  <!-- The panel does its own scrolling, because it owns the action row it has to keep pinned below the
       scrolled area. A ScrollViewer here would nest inside that one and re-hide the buttons. -->
  <panels:BcConverterPanel x:Name="ConverterPanel" x:FieldModifier="internal" Margin="12"
                           FontSize="{DynamicResource AppFontSize}"/>
</Window>
