<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="using:BallisticCalculator.Panels.Panels"
        x:Class="BallisticCalculator.Views.Dialogs.HitProbabilityDialog"
        Title="Hit Probability"
        Width="860" Height="600"
        MinWidth="700" MinHeight="480"
        FontSize="{DynamicResource AppFontSize}"
        WindowStartupLocation="CenterOwner"
        CanResize="true">

  <!-- No ScrollViewer here: the plot must take the space it is given, so the whole dialog must not
       scroll as one. The input column is taller than this window and scrolls on its own, inside the
       panel. -->
  <panels:HitProbabilityPanel x:Name="EstimatorPanel" x:FieldModifier="internal" Margin="12"
                              FontSize="{DynamicResource AppFontSize}"/>
</Window>
