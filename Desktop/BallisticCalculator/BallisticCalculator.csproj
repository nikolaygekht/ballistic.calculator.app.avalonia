<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>BallisticCalculator2</AssemblyName>
    <RootNamespace>BallisticCalculator</RootNamespace>
    <ApplicationIcon>Assets\Shooting.ico</ApplicationIcon>
    <Version>3.0.0</Version>
    <!-- Suppress AVLN3001: Dialogs use parameterized constructors by design -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AssemblyDate</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("u"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Copy the repository-root ./data folder (reticles, legacy ammo, drg tables, dictionaries)
       into a ./data subfolder next to the built binaries, preserving its structure. -->
  <ItemGroup>
    <Content Include="..\..\data\**\*">
      <Link>data\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[11.3.18,12)" />
    <PackageReference Include="Avalonia.Desktop" Version="[11.3.18,12)" />
    <PackageReference Include="Classic.Avalonia.Theme" Version="[11.3.0.3,12)" />
    <PackageReference Include="Avalonia.Diagnostics" Version="[11.3.18,12)">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="iciclecreek.Avalonia.WindowManager" Version="[4.0.4,5)" />
    <PackageReference Include="BallisticCalculator" Version="1.1.11.3" />
    <PackageReference Include="Gehtsoft.Measurements" Version="1.1.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\BallisticCalculator.Controls\BallisticCalculator.Controls.csproj" />
    <ProjectReference Include="..\..\Common\BallisticCalculator.Panels\BallisticCalculator.Panels.csproj" />
    <ProjectReference Include="..\..\Common\BallisticCalculator.Types\BallisticCalculator.Types.csproj" />
  </ItemGroup>
</Project>
