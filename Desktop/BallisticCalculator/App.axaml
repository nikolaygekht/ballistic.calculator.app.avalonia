<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BallisticCalculator.App"
             xmlns:local="using:BallisticCalculator">

    <Application.Resources>
        <!-- Application-wide font size - can be adjusted by user -->
        <x:Double x:Key="AppFontSize">13</x:Double>
    </Application.Resources>

    <Application.Styles>
        <StyleInclude Source="avares://Classic.Avalonia.Theme/ClassicTheme.axaml"/>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml"/>

        <!-- Every templated control follows the app font size, so controls built in code (the error and
             confirm boxes, About) scale with it too and not only the ones whose XAML asks. A FontSize set
             locally still wins, so deliberately larger headings are unaffected. TextBlock is not a
             templated control but inherits the size from its parent. -->
        <Style Selector=":is(TemplatedControl)">
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
        </Style>

        <!-- Custom styles to make menu scale with font size -->
        <Style Selector="MenuItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="NaN"/> <!-- Auto height -->
        </Style>
        <Style Selector="Menu">
            <Setter Property="Height" Value="NaN"/> <!-- Auto height -->
        </Style>
    </Application.Styles>
</Application>
