# Minimal Doxyfile for docgen integration (Java).
# Generated from `doxygen -g` and trimmed.

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = REPLACE_WITH_PROJECT_NAME
OUTPUT_DIRECTORY       = ./doxygen
OUTPUT_LANGUAGE        = English
OPTIMIZE_OUTPUT_JAVA   = YES
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
JAVADOC_AUTOBRIEF      = YES

# Source paths to scan, relative to this Doxyfile's directory:
INPUT                  = REPLACE_WITH_JAVA_SOURCE_PATH
RECURSIVE              = YES
FILE_PATTERNS          = *.java

# Required: docgen consumes the XML output.
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
