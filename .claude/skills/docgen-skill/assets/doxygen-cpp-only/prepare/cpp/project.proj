<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>netstandard2.0</TargetFramework>
  <DocGenVersion>0.1.34</DocGenVersion>
 </PropertyGroup>

 <ItemGroup>
  <PackageReference Include="Gehtsoft.Build.DocGen" Version="$(DocGenVersion)" IncludeAssets="build" />
  <PackageReference Include="Gehtsoft.Build.ContentDelivery" Version="0.1.10" IncludeAssets="build" />
 </ItemGroup>

 <PropertyGroup>
  <DoxyDir>$(MSBuildProjectDirectory)/doxygen</DoxyDir>
  <DestDir>$(MSBuildProjectDirectory)/dst</DestDir>
 </PropertyGroup>

 <ItemGroup>
  <CurrentDoxyDir Include="$(DoxyDir)" />
  <CurrentDestDir Include="$(DestDir)" />
 </ItemGroup>

 <Target Name="ClearDoc">
  <RemoveDir Directories="@(CurrentDoxyDir)" />
  <RemoveDir Directories="@(CurrentDestDir)" />
 </Target>

 <Target Name="Doxygen">
  <Exec Command="doxygen Doxyfile" />
  <!-- Drop per-file/per-directory XML noise; doxygen2ds only wants per-namespace and per-class XML -->
  <Exec Command="del $(DoxyDir)\xml\*8h.xml" />
  <Exec Command="del $(DoxyDir)\xml\*8cpp.xml" />
  <Exec Command="del $(DoxyDir)\xml\dir_*.xml" />
 </Target>

 <Target Name="Prepare">
  <RemoveDir Directories="@(CurrentDestDir)" />
  <MakeDir Directories="$(DestDir)" />
  <DocGen Project="prepareproject.xml" />
 </Target>
</Project>
