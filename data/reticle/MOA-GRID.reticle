<reticle name="MOA grid, 1 MOA graduation (MILDOT field of view)" size-x="12mrad" size-y="12mrad" zero-x="6mrad" zero-y="6mrad">
  <elements>
    <!-- field boundary and the fine cross -->
    <reticle-circle center-x="0moa" center-y="0moa" radius="20.62moa" fill="false" line-width="0.34moa" color="black" />
    <reticle-line start-x="-20.62moa" start-y="0moa" end-x="20.62moa" end-y="0moa" line-width="0.17moa" line-color="black" />
    <reticle-line start-x="0moa" start-y="20.62moa" end-x="0moa" end-y="-20.62moa" line-width="0.17moa" line-color="black" />
    <!-- heavy duplex posts on all four arms, from 5 mrad (17.19 MOA) to the field stop, as MILDOT does -->
    <reticle-line start-x="0moa" start-y="-17.19moa" end-x="0moa" end-y="-20.62moa" line-width="0.34moa" line-color="black" />
    <reticle-line start-x="0moa" start-y="17.19moa" end-x="0moa" end-y="20.62moa" line-width="0.34moa" line-color="black" />
    <reticle-line start-x="-17.19moa" start-y="0moa" end-x="-20.62moa" end-y="0moa" line-width="0.34moa" line-color="black" />
    <reticle-line start-x="17.19moa" start-y="0moa" end-x="20.62moa" end-y="0moa" line-width="0.34moa" line-color="black" />
    <!-- 1 MOA graduation to +/-14 MOA; even MOA marks longer than odd -->
    <reticle-line start-x="-1moa" start-y="0.5moa" end-x="-1moa" end-y="-0.5moa" line-width="0.17moa" line-color="black" />
    <reticle-line start-x="0.5moa" start-y="-1moa" end-x="-0.5moa" end-y="-1moa" line-width="0.17moa" line-color="black" />
    <reticle-line start-x="1moa" start-y="0.5moa" end-x="1moa" end-y="-0.5moa" line-width="0.17moa" line-color="black" />
    <reticle-line start-x="0.5moa" start-y="1moa" end-x="-0.5moa" end-y="1moa" line-width="0.17moa" line-color="black" />
    <reticle-line start-x="-2moa" start-y="0.7moa" end-x="-2moa" end-y="-0.7moa" line-width="0.17moa" line-color="black" />
