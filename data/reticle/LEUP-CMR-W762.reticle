    <!-- mil ruler above the left arm: ticks on whole milliradians, 1.00 mil spacing -->
    <reticle-line start-x="-10.1mrad" start-y="0mrad" end-x="-10.1mrad" end-y="5.2mrad" line-width="0.31mrad" line-color="black" />
