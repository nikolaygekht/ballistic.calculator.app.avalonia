<!-- Leupold CMR-W 7.62 Illum. FFP, framed to the 20 mil mark so the drop ladder
     is not dwarfed; the etched arms continue to about 39.7 mil and are closed by
     3.00 mil heavy field-stop blocks, which are outside this frame. The spine also
     runs off-frame - the etching continues to about 24 mil below the axis.
     Drop ladder is Leupold's own published table for the 7.62/.308 175 gr load at
     2575 fps with a 50 m zero: 300 m 1.33, 400 m 2.43, 500 m 3.67, 600 m 5.09,
     700 m 6.69, 800 m 8.51, 900 m 10.61, 1000 m 13.01, 1100 m 15.78, 1200 m 18.93 mil.
     Line weights (3.00 / 1.00 / 0.20 mil), horseshoe (2.18 mil OD, 1.46 mil ID), dot
     (0.15 mil) and the 1.00 mil ruler spacing are published. Crossbar widths, the
     half-range ticks and the 15/20 mil outer ticks are measured off the sheet, which
     is drawn to scale (its hash axis gives 41.0 px/mil and its ladder 41.4 px/mil
     against the published 18.93 mil at 1200 m, and all ten published drops land
     within 0.1 mil of their drawn rows).
     The 10 and 20 mph wind holds of the etched christmas tree are NOT reproduced -
     no source publishes their positions. See the .md file. -->
<reticle name="Leupold CMR-W 7.62 (mil, to the 20 mil mark)" size-x="42mrad" size-y="28mrad" zero-x="21mrad" zero-y="7mrad">
  <elements>
    <!-- 1.00 mil medium arms, running off-frame past the 20 mil tick -->
    <reticle-line start-x="-21mrad" start-y="0mrad" end-x="-10.4mrad" end-y="0mrad" line-width="1mrad" line-color="black" />
    <reticle-line start-x="-15mrad" start-y="-1mrad" end-x="-15mrad" end-y="1mrad" line-width="0.3mrad" line-color="black" />
    <reticle-line start-x="-20mrad" start-y="-1mrad" end-x="-20mrad" end-y="1mrad" line-width="0.3mrad" line-color="black" />
    <reticle-line start-x="21mrad" start-y="0mrad" end-x="10.4mrad" end-y="0mrad" line-width="1mrad" line-color="black" />
    <reticle-line start-x="15mrad" start-y="-1mrad" end-x="15mrad" end-y="1mrad" line-width="0.3mrad" line-color="black" />
    <reticle-line start-x="20mrad" start-y="-1mrad" end-x="20mrad" end-y="1mrad" line-width="0.3mrad" line-color="black" />
    <!-- fine axis and the 1 mil hash scale, numbered every 2 mil -->
    <reticle-line start-x="-10.4mrad" start-y="0mrad" end-x="-1.09mrad" end-y="0mrad" line-width="0.2mrad" line-color="black" />
    <reticle-line start-x="-2mrad" start-y="-0.5mrad" end-x="-2mrad" end-y="0.5mrad" line-width="0.2mrad" line-color="black" />
    <reticle-text position-x="-2.35mrad" position-y="-1.15mrad" text-height="0.7mrad" text="2" anchor="Left" text-color="black" />
    <reticle-line start-x="-3mrad" start-y="-0.3mrad" end-x="-3mrad" end-y="0.3mrad" line-width="0.2mrad" line-color="black" />
    <reticle-line start-x="-4mrad" start-y="-0.5mrad" end-x="-4mrad" end-y="0.5mrad" line-width="0.2mrad" line-color="black" />
