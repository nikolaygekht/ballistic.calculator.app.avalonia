    <reticle-text position-x="0.675mrad" position-y="-5.34mrad" text-height="0.7mrad" text="6" anchor="Left" text-color="black" />
    <reticle-line start-x="-0.33mrad" start-y="-6.69mrad" end-x="0.33mrad" end-y="-6.69mrad" line-width="0.25mrad" line-color="black" />
