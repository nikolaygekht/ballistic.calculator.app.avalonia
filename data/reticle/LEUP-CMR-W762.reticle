    <reticle-line start-x="-0.16mrad" start-y="-9.56mrad" end-x="0.16mrad" end-y="-9.56mrad" line-width="0.18mrad" line-color="black" />
    <reticle-line start-x="-0.16mrad" start-y="-11.81mrad" end-x="0.16mrad" end-y="-11.81mrad" line-width="0.18mrad" line-color="black" />
