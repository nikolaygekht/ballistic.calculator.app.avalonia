<!-- Trijicon ACOG TA44 1.5x16S RTR 9mm PCC (TA44-C-400389), from Trijicon's per-part reticle sheet.
     Every position here is a PRINTED dimension - the sheet is stamped "*Reticles not
     drawn to scale", so nothing was measured off it.
     Horseshoe 18.1 MOA outer diameter, 1.0 MOA thick, 9.1 MOA gap at the bottom
     (printed); 2.0 MOA aiming dot; 0.44 MOA bars and spine; numerals 5.0 MOA tall at
     10 MOA from the spine.
     150 yd: drop 10.9 MOA, bar 12.1 MOA
     200 yd: drop 19.0 MOA, bar 9.1 MOA
     250 yd: drop 28.3 MOA, bar 7.3 MOA
     300 yd: drop 38.6 MOA, bar 6.1 MOA
     The numerals are hundreds of YARDS. That is fixed by the 9 mm sheet, which
     dimensions every bar: its widths are 19 in at 150/200/250/300 yd to within 1%,
     where reading them as metres would imply a 20.8 in target - out by exactly the
     yard/metre ratio. 
     Trijicon publishes no load, muzzle velocity or zero for this reticle. -->
<reticle name="ACOG TA44 1.5x16S RTR 9mm PCC" size-x="44moa" size-y="58moa" zero-x="22moa" zero-y="13moa">
  <elements>
    <!-- RTR horseshoe: 18.1 MOA outer diameter, 1.0 MOA thick, 9.1 MOA gap at the bottom -->
    <reticle-path fill="false" line-width="1moa" color="black">
      <elements>
        <reticle-path-move-to position-x="4.550moa" position-y="-7.239moa" />
        <reticle-path-arc radius="8.550moa" clockwise="false" major-arc="true" position-x="-4.550moa" position-y="-7.239moa" />
      </elements>
    </reticle-path>
    <!-- 2.0 MOA aiming dot at the centre -->
    <reticle-circle center-x="0moa" center-y="0moa" radius="1moa" fill="true" line-width="0.05moa" color="red" />
    <!-- ladder: crossbar at each printed drop; each bar is 19 in wide at its own range -->
    <reticle-line start-x="0moa" start-y="-9.05moa" end-x="0moa" end-y="-38.6moa" line-width="0.44moa" line-color="black" />
    <reticle-line start-x="-6.05moa" start-y="-10.9moa" end-x="6.05moa" end-y="-10.9moa" line-width="0.44moa" line-color="black" />
    <reticle-line start-x="-4.55moa" start-y="-19moa" end-x="4.55moa" end-y="-19moa" line-width="0.44moa" line-color="black" />
    <reticle-text position-x="10moa" position-y="-21.5moa" text-height="5moa" text="2" anchor="Left" text-color="black" />
    <reticle-line start-x="-3.65moa" start-y="-28.3moa" end-x="3.65moa" end-y="-28.3moa" line-width="0.44moa" line-color="black" />
    <reticle-line start-x="-3.05moa" start-y="-38.6moa" end-x="3.05moa" end-y="-38.6moa" line-width="0.44moa" line-color="black" />
    <reticle-text position-x="10moa" position-y="-41.1moa" text-height="5moa" text="3" anchor="Left" text-color="black" />
  </elements>
  <bdc>
    <bdc position-x="0moa" position-y="-10.9moa" text-offset="-18moa" text-height="4moa" />
    <bdc position-x="0moa" position-y="-19moa" text-offset="-18moa" text-height="4moa" />
    <bdc position-x="0moa" position-y="-28.3moa" text-offset="-18moa" text-height="4moa" />
    <bdc position-x="0moa" position-y="-38.6moa" text-offset="-18moa" text-height="4moa" />
  </bdc>
</reticle>
