    <reticle-line start-x="-0.15mrad" start-y="-2.5mrad" end-x="0.15mrad" end-y="-2.5mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="2.5mrad" start-y="-0.15mrad" end-x="2.5mrad" end-y="0.15mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-0.15mrad" start-y="2.5mrad" end-x="0.15mrad" end-y="2.5mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-3mrad" start-y="-0.25mrad" end-x="-3mrad" end-y="0.25mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-0.25mrad" start-y="-3mrad" end-x="0.25mrad" end-y="-3mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="3mrad" start-y="-0.25mrad" end-x="3mrad" end-y="0.25mrad" line-width="0.05mrad" line-color="red" />
