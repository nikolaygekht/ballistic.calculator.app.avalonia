<reticle name="EOTech Vudu MD1 (FFP, mrad)" size-x="14mrad" size-y="14mrad" zero-x="7mrad" zero-y="7mrad">
  <elements>
    <!-- fine crosshair, 0.05 mrad lines, graduated every 0.5 mrad to 5 mrad -->
    <reticle-line start-x="-5mrad" start-y="0mrad" end-x="5mrad" end-y="0mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="0mrad" start-y="5mrad" end-x="0mrad" end-y="-5mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-0.5mrad" start-y="-0.15mrad" end-x="-0.5mrad" end-y="0.15mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-0.15mrad" start-y="-0.5mrad" end-x="0.15mrad" end-y="-0.5mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="0.5mrad" start-y="-0.15mrad" end-x="0.5mrad" end-y="0.15mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-0.15mrad" start-y="0.5mrad" end-x="0.15mrad" end-y="0.5mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-1mrad" start-y="-0.25mrad" end-x="-1mrad" end-y="0.25mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-0.25mrad" start-y="-1mrad" end-x="0.25mrad" end-y="-1mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="1mrad" start-y="-0.25mrad" end-x="1mrad" end-y="0.25mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-0.25mrad" start-y="1mrad" end-x="0.25mrad" end-y="1mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-1.5mrad" start-y="-0.15mrad" end-x="-1.5mrad" end-y="0.15mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-0.15mrad" start-y="-1.5mrad" end-x="0.15mrad" end-y="-1.5mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="1.5mrad" start-y="-0.15mrad" end-x="1.5mrad" end-y="0.15mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-0.15mrad" start-y="1.5mrad" end-x="0.15mrad" end-y="1.5mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-2mrad" start-y="-0.25mrad" end-x="-2mrad" end-y="0.25mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-0.25mrad" start-y="-2mrad" end-x="0.25mrad" end-y="-2mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="2mrad" start-y="-0.25mrad" end-x="2mrad" end-y="0.25mrad" line-width="0.05mrad" line-color="red" />
    <reticle-line start-x="-0.25mrad" start-y="2mrad" end-x="0.25mrad" end-y="2mrad" line-width="0.05mrad" line-color="red" />
