<reticle name="EOTech Vudu SR-2 (7.62 M118LR) (FFP, mrad)" size-x="14mrad" size-y="12mrad" zero-x="7mrad" zero-y="4mrad">
  <elements>
    <!-- speed ring: 2.15 mrad outer diameter, 0.3 mrad thick, closed -->
    <reticle-circle center-x="0mrad" center-y="0mrad" radius="0.925mrad" fill="false" line-width="0.3mrad" color="red" />
    <!-- 0.44 mrad (1.5 MOA) centre dot -->
    <reticle-circle center-x="0mrad" center-y="0mrad" radius="0.22mrad" fill="true" line-width="0.02mrad" color="red" />
    <!-- reference ticks on the horizontal at 4 and 6 mrad (13.75 and 20.63 MOA) -->
    <reticle-line start-x="-4mrad" start-y="-0.4mrad" end-x="-4mrad" end-y="0.4mrad" line-width="0.07mrad" line-color="black" />
    <reticle-line start-x="4mrad" start-y="-0.4mrad" end-x="4mrad" end-y="0.4mrad" line-width="0.07mrad" line-color="black" />
    <reticle-line start-x="-6mrad" start-y="-0.4mrad" end-x="-6mrad" end-y="0.4mrad" line-width="0.07mrad" line-color="black" />
    <reticle-line start-x="6mrad" start-y="-0.4mrad" end-x="6mrad" end-y="0.4mrad" line-width="0.07mrad" line-color="black" />
    <!-- vertical spine connecting the BDC bars - from the '4' bar to the '6' bar only, nothing above it -->
    <reticle-line start-x="0mrad" start-y="-2.5mrad" end-x="0mrad" end-y="-5mrad" line-width="0.07mrad" line-color="black" />
    <!-- BDC bars, 0.07 mrad thick; width is not published - drawn 1.0 mrad -->
    <reticle-line start-x="-0.5mrad" start-y="-2.5mrad" end-x="0.5mrad" end-y="-2.5mrad" line-width="0.07mrad" line-color="black" />
    <reticle-text position-x="0.75mrad" position-y="-2.72mrad" text-height="0.5mrad" text="4" anchor="Left" text-color="black" />
    <reticle-line start-x="-0.5mrad" start-y="-3.7mrad" end-x="0.5mrad" end-y="-3.7mrad" line-width="0.07mrad" line-color="black" />
    <reticle-text position-x="0.75mrad" position-y="-3.92mrad" text-height="0.5mrad" text="5" anchor="Left" text-color="black" />
    <reticle-line start-x="-0.5mrad" start-y="-5mrad" end-x="0.5mrad" end-y="-5mrad" line-width="0.07mrad" line-color="black" />
    <reticle-text position-x="0.75mrad" position-y="-5.22mrad" text-height="0.5mrad" text="6" anchor="Left" text-color="black" />
  </elements>
  <bdc>
    <bdc position-x="0mrad" position-y="-2.5mrad" text-offset="-3.2mrad" text-height="0.45mrad" />
    <bdc position-x="0mrad" position-y="-3.7mrad" text-offset="-3.2mrad" text-height="0.45mrad" />
    <bdc position-x="0mrad" position-y="-5mrad" text-offset="-3.2mrad" text-height="0.45mrad" />
  </bdc>
</reticle>
